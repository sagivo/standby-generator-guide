---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { SITE_URL } from "../../lib/site";
import { breadcrumbLd } from "../../lib/schema";

const title = "Standby vs. Portable Generator: Cost & Convenience Compared";
const description =
  "Should you buy a whole-house standby generator or a portable? Compare 10-year costs, fuel, noise and convenience side by side.";
const url = `${SITE_URL}/tools/standby-vs-portable/`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Tools", href: "/tools/" },
  { name: "Standby vs. portable", href: "/tools/standby-vs-portable/" },
];
const jsonLd = [
  breadcrumbLd(crumbs),
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Standby vs Portable Generator Comparison",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    url,
  },
];
---

<BaseLayout title={title} description={description} canonical={url} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="calc-hero">
      <h1>Standby vs. portable generator</h1>
      <p>
        A portable costs a tenth of a standby — but you pay in fuel runs, noise,
        and 2 a.m. extension cords. Tell us about your outages and we'll do the
        10-year math.
      </p>
    </div>

    <div class="calc" id="vs-calc">
      <div class="row">
        <div>
          <label for="outages">Outage hours per year <output id="outages-out">24 hours</output></label>
          <input id="outages" type="range" min="4" max="200" step="4" value="24" />
        </div>
        <div>
          <label for="years">Compare over</label>
          <select id="years">
            <option value="5">5 years</option>
            <option value="10" selected>10 years</option>
            <option value="15">15 years</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div>
          <label for="fuelprice">Gasoline price ($/gal) <output id="fuelprice-out">$3.50</output></label>
          <input id="fuelprice" type="range" min="2.5" max="6" step="0.1" value="3.5" />
        </div>
        <div>
          <label for="ngprice">Natural gas / propane cost factor</label>
          <select id="ngprice">
            <option value="0.7" selected>Typical (standby fuel ~30% cheaper per kWh)</option>
            <option value="1">Same as gasoline</option>
            <option value="1.3">Expensive propane market</option>
          </select>
        </div>
      </div>
      <p style="margin-top:1.5rem;"><button class="btn" id="vs-btn" type="button">Compare ⚖️</button></p>
      <div class="calc-result" id="vs-result" aria-live="polite"></div>
    </div>

    <article class="prose" data-pagefind-body>
      <h2>The honest comparison</h2>
      <table class="spec-table">
        <thead><tr><th></th><th>Portable (10–12 kW)</th><th>Standby (20 kW)</th></tr></thead>
        <tbody>
          <tr><th scope="row">Equipment</th><td>~$1,200–$2,500</td><td>~$5,500–$7,000</td></tr>
          <tr><th scope="row">Installation</th><td>$500–$1,500 (inlet + interlock)</td><td>$4,000–$8,000 (ATS, gas, permits)</td></tr>
          <tr><th scope="row">Starts itself?</th><td>No — you're outside in the storm</td><td>Yes, in ~10 seconds, even if you're away</td></tr>
          <tr><th scope="row">Fuel</th><td>Gasoline: refuel every 8–12 hrs</td><td>Natural gas / propane: runs for days</td></tr>
          <tr><th scope="row">Noise</th><td>70–78 dB(A) — loud</td><td>62–69 dB(A) — conversation level</td></tr>
          <tr><th scope="row">Powers</th><td>Essentials via cords or inlet</td><td>Whole house through the panel</td></tr>
          <tr><th scope="row">Maintenance</th><td>Oil, stabilizer, exercise monthly</td><td>Weekly self-test, annual service</td></tr>
        </tbody>
      </table>
      <h2>When portable wins</h2>
      <p>
        Outages are rare and short (under ~12 hours a year), you're comfortable
        running extension cords, and someone is always home to start it. A good
        dual-fuel portable with a manual transfer switch is genuinely capable —
        it's just manual.
      </p>
      <h2>When standby wins</h2>
      <p>
        You lose power for days at a time, travel, work from home, have medical
        equipment, a sump pump, or an electric well — anything where "someone
        goes outside and starts the generator" isn't an acceptable plan. Standby
        also adds resale value; portables don't.
      </p>
      <p>
        Ready to size one? Use the <a href="/tools/kw-size-calculator/">kW size calculator</a>,
        then see what installation really costs with the
        <a href="/tools/install-cost-estimator/">cost estimator</a>.
      </p>
    </article>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");
    const paint = (el) => {
      const pct = ((el.value - el.min) / (el.max - el.min)) * 100;
      el.style.setProperty("--fill", pct + "%");
    };
    const sync = () => {
      ["outages", "fuelprice"].forEach((id) => paint($(id)));
      $("outages-out").textContent = $("outages").value + " hours";
      $("fuelprice-out").textContent = "$" + parseFloat($("fuelprice").value).toFixed(2);
    };
    ["outages", "fuelprice"].forEach((id) => $(id).addEventListener("input", sync));
    sync();

    $("vs-btn").addEventListener("click", () => {
      const hrs = parseFloat($("outages").value);
      const yrs = parseFloat($("years").value);
      const gasPrice = parseFloat($("fuelprice").value);
      const fuelMult = parseFloat($("ngprice").value);

      // Portable: 1.1 gal/hr at ~50% load of a 10kW unit
      const portFuel = hrs * 1.1 * gasPrice * yrs;
      const portTotal = 1800 + 1000 + portFuel + yrs * 60;
      // Standby: ~2.2 gal/hr propane-equivalent at half load of 20kW; NG/LP cheaper per kWh
      const stbyFuel = hrs * 2.2 * gasPrice * fuelMult * yrs;
      const stbyTotal = 6000 + 5500 + stbyFuel + yrs * 300;

      $("vs-result").innerHTML = `
        <h3>10-year cost over ${yrs} years at ${hrs} outage-hours/year</h3>
        <table class="spec-table"><tbody>
          <tr><th scope="row">Portable (unit + inlet + fuel + upkeep)</th><td><strong>${fmt(portTotal)}</strong></td></tr>
          <tr><th scope="row">Standby (unit + install + fuel + service)</th><td><strong>${fmt(stbyTotal)}</strong></td></tr>
          <tr><th scope="row">Difference</th><td>${fmt(Math.abs(stbyTotal - portTotal))} ${stbyTotal > portTotal ? "more for standby" : "more for portable"}</td></tr>
        </tbody></table>
        <p>Standby costs roughly <strong>${(stbyTotal / portTotal).toFixed(1)}×</strong> the portable over ${yrs} years.
        What that buys: automatic start, whole-house coverage, days of unattended runtime, and no 2 a.m. fuel runs.
        ${hrs >= 48 ? "At your outage level, the convenience case for standby is strong." : "At your outage level, a portable is the rational buy unless you need automatic backup (travel, medical, sump pump)."}</p>
        <p class="fine">Simplified model: typical fuel burn and 2026 cost averages. Your numbers will vary — the point is the order of magnitude, not the exact dollar.</p>`;
      $("vs-result").scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</BaseLayout>
