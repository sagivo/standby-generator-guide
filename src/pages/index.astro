---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const topModels = [...MODELS].sort((a, b) => b.score - a.score).slice(0, 6);
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks (overall, hills, trees, budget).
const ACCENTS = ["#c8f03c", "#ff9a6b", "#7fd8c6", "#ffd34f"];

// Each tile shows the #1 pick from its guide, so readers can buy straight from the homepage.
const yardTypes = [
  { slug: "best-standby-generators-2026", icon: "🏆", title: "Best overall", text: "The top whole-house standby generators of 2026, ranked." },
  { slug: "generac-vs-kohler", icon: "⚔️", title: "Generac vs Kohler", text: "The two big American brands, head to head." },
  { slug: "standby-generator-sizing-guide", icon: "⚡", title: "What size do I need?", text: "kW sizing explained: loads, surges and margins." },
  { slug: "standby-generator-installation-cost", icon: "💰", title: "Installation costs", text: "The true installed price, line by line." },
  { slug: "standby-vs-portable-generator", icon: "⚖️", title: "Standby vs portable", text: "When a portable is enough — and when it isn't." },
  { slug: "standby-generator-maintenance", icon: "🔧", title: "Maintenance guide", text: "Annual service, exercise cycles and batteries." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What is the best standby generator in 2026?",
    a: `It depends on your home. Our top-rated pick overall is the ${picks[0].model.name}. For most 2,500 sq ft homes with central air, a 22 kW unit is the sweet spot; budget buyers should look at 14 kW with load management. Our best standby generators guide ranks them by home size.`,
  },
  {
    q: "What size standby generator do I need?",
    a: "Add up your running watts plus your largest motor's starting surge, then add 20–25% margin. Roughly: 14 kW for essentials + one AC, 18–20 kW for most of a 1,500–2,500 sq ft home, 22–26 kW for true whole-house backup. Our kW size calculator does the math in two minutes.",
  },
  {
    q: "How much does a standby generator cost installed?",
    a: "The unit runs roughly $4,500–$7,500; professional installation adds $4,000–$8,000 for the transfer switch, gas line, panel work, pad and permits. Most homeowners land at $10,000–$15,000 all-in. Our installation cost estimator breaks it down.",
  },
  {
    q: "Are standby generators worth it?",
    a: "If you lose power for days, travel, work from home, or depend on a sump pump, well, or medical equipment — yes. Automatic start and whole-house coverage are the payoff. For rare, short outages, a portable is the rational buy; our standby vs. portable comparison runs the 10-year math.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top home standby generators of 2026", picks.map((p) => p.model)), faqLd(faq)];
---

<BaseLayout
  title={`${SITE_NAME}: Best Home Standby Generators of 2026, Compared`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>The best standby generators of 2026, <em>ranked.</em></h1>
        <p class="lead">
          We compared {MODELS.length} home standby generators on power, fuel, transfer switch,
          noise and price, so the lights stay on — and you skip the research.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/best-standby-generators-2026/">See the ranking</a>
          <a class="btn secondary btn-lg" href="#match">Size my generator</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>models compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands compared</span></div>
          <div><strong>10</strong><span>second auto-start</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>🏆 #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/generators/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="ring" style={`--v:${top.score * 10}`}><span>{top.score.toFixed(1)}</span></span>
            <span class="ring-label"><strong>Guide score</strong>out of 10</span>
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{priceTier(top).label} price tier</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/generators/${top.id}/`}>Read the review →</a>
            <a href="/generators/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free sizing &amp; cost calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 generators we'd buy in 2026</h2>
        <p class="section-sub">One clear winner for each kind of home. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/posts/best-standby-generators-2026/">Full ranking →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <div class="matcher" id="match">
      <div>
        <span class="eyebrow" style="color:var(--ink)">30-second sizer</span>
        <h2>What size generator does your home need?</h2>
        <p>14 kW covers essentials plus one AC. 18–20 kW handles most of a 1,500–2,500 sq ft home. 22–26 kW is true whole-house backup. Get your exact number:</p>
      </div>
      <div class="mq">
        <a class="btn dark btn-lg" href="/tools/kw-size-calculator/">Calculate my kW →</a>
        <a class="btn secondary btn-lg" href="/tools/install-cost-estimator/">Estimate install cost</a>
      </div>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Shop by yard</span>
        <h2 class="section-title">Best generator for your situation</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {yardTypes.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">See every pick</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Highest-rated models at a glance</h2>
      </div>
      <a class="section-link" href="/generators/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={topModels} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/kw-size-calculator/">
        <div class="tool-icon">⚡</div>
        <h3>kW Size Calculator</h3>
        <p>Check your essential loads and get the generator size your home actually needs.</p>
        <span class="go">Size my generator</span>
      </a>
      <a class="tool-card" href="/tools/install-cost-estimator/">
        <div class="tool-icon">💰</div>
        <h3>Installation Cost Estimator</h3>
        <p>The true installed price: unit, labor, gas line, panel work, pad and permits.</p>
        <span class="go">Estimate my cost</span>
      </a>
      <a class="tool-card" href="/tools/standby-vs-portable/">
        <div class="tool-icon">⚖️</div>
        <h3>Standby vs. Portable</h3>
        <p>10-year cost comparison plus the honest convenience trade-offs.</p>
        <span class="go">Compare</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which generator we recommend.</p>
        <a class="btn" href="/how-we-research/">How we score generators</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>Standby only</h3><p>Every model we cover is a permanent, automatic whole-house system. No portables, no manual transfer panels.</p></div>
        <div><div class="n">02</div><h3>Specs, cross-checked</h3><p>kW ratings, fuel derates and warranty terms verified across manufacturers, reviews and owner reports.</p></div>
        <div><div class="n">03</div><h3>Tools, not just words</h3><p>Calculators built from real specs turn "what size generator?" into a number, not a guess.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">Standby generator FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
